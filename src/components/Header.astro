---
import Monogram from "./Monogram.astro";
import { isCurrentPath, NAV } from "../lib/nav";

const path = Astro.url.pathname;
---

<header
  class="site-header border-hairline bg-surface z-header sticky top-0 border-b"
  transition:persist
  transition:name="site-header"
>
  <div class="section-inner flex items-center justify-between gap-8 py-6">
    <a
      href="/"
      class="site-logo"
      transition:name="fm-monogram"
      aria-label="Foreverlikethemoon, home"
    >
      <Monogram class="site-logo__mark" />
    </a>

    <nav class="site-nav hidden lg:block" aria-label="Primary">
      <ul class="flex items-center gap-8">
        {
          NAV.map((item) => (
            <li>
              <a
                href={item.href}
                aria-current={isCurrentPath(path, item.href) ? "page" : undefined}
              >
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <button
      type="button"
      class="icon-btn lg:hidden"
      id="nav-open"
      aria-expanded="false"
      aria-controls="nav-sheet"
    >
      Menu
    </button>
  </div>

  <div
    class="nav-sheet"
    id="nav-sheet"
    role="dialog"
    aria-modal="true"
    aria-labelledby="nav-sheet-title"
    data-open="false"
  >
    <div class="flex items-center justify-between px-6 py-6">
      <p class="font-display text-xl italic" id="nav-sheet-title">
        Menu
      </p>
      <button type="button" class="icon-btn" id="nav-close">Close</button>
    </div>
    <nav class="px-6 py-12" aria-label="Primary">
      <ul class="flex flex-col gap-8">
        {
          NAV.map((item) => (
            <li>
              <a
                href={item.href}
                aria-current={isCurrentPath(path, item.href) ? "page" : undefined}
              >
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
</header>

<script>
  import "./nav-sheet.ts";
</script>
