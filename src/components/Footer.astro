---
import { LEGAL } from "../lib/nav";
import { CONTACT, SOCIAL } from "../lib/site";
---

<footer class="border-hairline mt-auto border-t px-6 py-section">
  <div class="flex flex-col gap-12 md:flex-row md:justify-between">
    <address class="text-ink-muted not-italic">
      <p class="eyebrow">Contact</p>
      <p class="mt-3">
        <a href={CONTACT.phoneHref}>{CONTACT.phoneDisplay}</a>
      </p>
      <p class="mt-2">
        <a href={`mailto:${CONTACT.email}`}>{CONTACT.email}</a>
      </p>
      <p class="mt-2">{CONTACT.locality}</p>
      <p class="mt-2">{CONTACT.hoursLabel}</p>
    </address>

    <div>
      <p class="eyebrow">Follow</p>
      <ul class="mt-3 flex flex-col gap-2">
        {
          SOCIAL.map((item) => (
            <li>
              <a href={item.href} rel="noreferrer">{item.label}</a>
            </li>
          ))
        }
      </ul>
    </div>

    <div>
      <p class="eyebrow">Legal</p>
      <ul class="mt-3 flex flex-col gap-2">
        {
          LEGAL.map((item) => (
            <li>
              <a href={item.href}>{item.label}</a>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</footer>
