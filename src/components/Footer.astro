---
import { LEGAL } from "../lib/nav";
import { CONTACT, SOCIAL } from "../lib/site";
---

<footer class="site-footer mt-auto">
  <div class="section-inner">
    <div class="flex flex-col gap-16 md:flex-row md:justify-between">
      <address class="text-ink-muted not-italic">
        <p class="eyebrow">Contact</p>
        <p class="mt-4">
          <a href={CONTACT.phoneHref}>{CONTACT.phoneDisplay}</a>
        </p>
        <p class="mt-2">
          <a href={`mailto:${CONTACT.email}`}>{CONTACT.email}</a>
        </p>
        <p class="mt-2">{CONTACT.locality}</p>
        <p class="mt-2">{CONTACT.hoursLabel}</p>
      </address>

      <div>
        <p class="eyebrow">Follow</p>
        <ul class="mt-4 flex flex-col gap-2">
          {
            SOCIAL.map((item) => (
              <li>
                <a href={item.href} rel="noreferrer">
                  {item.label}
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <div>
        <p class="eyebrow">Legal</p>
        <ul class="mt-4 flex flex-col gap-2">
          {
            LEGAL.map((item) => (
              <li>
                <a href={item.href}>{item.label}</a>
              </li>
            ))
          }
        </ul>
      </div>
    </div>

    <p class="wordmark text-display-2 lg:text-display-4" aria-hidden="true">
      Foreverlikethemoon
    </p>
  </div>
</footer>
