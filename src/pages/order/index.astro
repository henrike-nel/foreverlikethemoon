---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { formatZAR } from "../../lib/format-zar";
import { CONTACT } from "../../lib/site";
import { SA_PROVINCES } from "../../lib/orders";

// Only in-stock products can be ordered. Out-of-stock and sold-out listings
// still render on the store, but their buy control is a "tell me when it's
// back" mailto there — they never reach this form with a live option.
const orderable = (await getCollection("products"))
  .filter((product) => product.data.stock === "in-stock")
  .toSorted((a, b) => a.data.order - b.data.order);

// Static subject for the no-JS mailto path. The enhanced path composes a far
// richer body through submitOrder(); this is the floor, not the ceiling.
const mailtoAction = `mailto:${CONTACT.email}?subject=${encodeURIComponent(
  "New order from foreverlikethemoon.com",
)}`;
---

<BaseLayout
  title="Place an order — Foreverlikethemoon"
  description="Order a wedding planner. We confirm by WhatsApp and email; payment is by EFT or PayShap."
>
  <section class="band" aria-labelledby="order-heading">
    <div class="section-inner order-layout">
      <header class="flex flex-col gap-4">
        <p class="eyebrow">Order</p>
        <h1 id="order-heading">Place an order</h1>
        <p class="measure text-ink-muted">
          Fill this in and we confirm by WhatsApp and email, then send payment
          details. Nothing is charged here — payment is a separate EFT or PayShap
          transfer once we've confirmed.
        </p>
      </header>

      {
        orderable.length === 0 ? (
          <p class="measure" role="status">
            Nothing is available to order right now.{" "}
            <a href="/store">See the store</a> for what's coming, or{" "}
            <a href={`mailto:${CONTACT.email}`}>email us</a> to be told when a
            product is back.
          </p>
        ) : (
          <form
            id="order-form"
            class="order-form"
            method="post"
            action={mailtoAction}
            enctype="text/plain"
            novalidate
          >
            {/* Reference. Generated client-side and shown prominently; on the
               no-JS path it is assigned by us when the emailed order arrives. */}
            <div class="order-ref-panel" data-ref-panel hidden>
              <p class="eyebrow">Your reference</p>
              <p class="order-ref-value order-ref tabular" data-ref-value />
              <input type="hidden" name="reference" data-ref-input />
              <p class="field-hint">
                Quote this on your payment and any message to us.
              </p>
            </div>

            <div class="field">
              <label class="field-label" for="order-name">Full name</label>
              <input
                class="field-input"
                id="order-name"
                name="name"
                type="text"
                autocomplete="name"
                required
                aria-describedby="order-name-error"
              />
              <p class="field-error" id="order-name-error" data-error hidden />
            </div>

            <div class="field">
              <label class="field-label" for="order-email">Email</label>
              <input
                class="field-input"
                id="order-email"
                name="email"
                type="email"
                autocomplete="email"
                inputmode="email"
                required
                aria-describedby="order-email-hint order-email-error"
              />
              <p class="field-hint" id="order-email-hint">
                Where a digital file is sent, and where we confirm.
              </p>
              <p class="field-error" id="order-email-error" data-error hidden />
            </div>

            <div class="field">
              <label class="field-label" for="order-whatsapp">
                WhatsApp number
              </label>
              <input
                class="field-input"
                id="order-whatsapp"
                name="whatsapp"
                type="tel"
                autocomplete="tel"
                inputmode="tel"
                required
                placeholder="+27 72 000 0000"
                aria-describedby="order-whatsapp-hint order-whatsapp-error"
              />
              <p class="field-hint" id="order-whatsapp-hint">
                We send order updates and take proof of payment here.
              </p>
              <p
                class="field-error"
                id="order-whatsapp-error"
                data-error
                hidden
              />
            </div>

            <div class="field" data-product-select-field>
              <label class="field-label" for="order-product">Product</label>
              <select
                class="field-input"
                id="order-product"
                name="product"
                required
                aria-describedby="order-product-error"
              >
                <option value="" selected disabled>
                  Choose a product
                </option>
                {orderable.map((product) => (
                  <option
                    value={product.data.slug}
                    data-title={product.data.title}
                    data-price={String(product.data.price)}
                    data-kind={product.data.kind}
                  >
                    {product.data.title} — {formatZAR(product.data.price)}
                  </option>
                ))}
              </select>
              <p
                class="field-error"
                id="order-product-error"
                data-error
                hidden
              />
            </div>

            {/* Locked product readout, shown by the island when ?product= is
               valid. The disabled select above cannot submit, so this carries
               a hidden input with the slug. */}
            <div class="order-locked" data-product-locked hidden>
              <p class="eyebrow">Product</p>
              <p class="order-locked-title" data-product-locked-title />
              <input type="hidden" name="product" data-product-locked-input />
              <button type="button" class="text-btn" data-product-change>
                Change product
              </button>
            </div>

            <div class="field order-qty">
              <label class="field-label" for="order-quantity">Quantity</label>
              <input
                class="field-input"
                id="order-quantity"
                name="quantity"
                type="number"
                min="1"
                step="1"
                value="1"
                inputmode="numeric"
                required
                aria-describedby="order-quantity-error"
              />
              <p
                class="field-error"
                id="order-quantity-error"
                data-error
                hidden
              />
            </div>

            <fieldset class="order-address" data-address hidden>
              <legend class="field-label">Delivery address</legend>
              <p class="field-hint" data-address-hint>
                For physical items shipped within South Africa.
              </p>

              <div class="field">
                <label class="field-label" for="order-line1">
                  Street address
                </label>
                <input
                  class="field-input"
                  id="order-line1"
                  name="address_line1"
                  type="text"
                  autocomplete="address-line1"
                  aria-describedby="order-line1-error"
                />
                <p
                  class="field-error"
                  id="order-line1-error"
                  data-error
                  hidden
                />
              </div>

              <div class="field">
                <label class="field-label" for="order-line2">
                  Apartment, complex, unit <span class="field-hint">(optional)</span>
                </label>
                <input
                  class="field-input"
                  id="order-line2"
                  name="address_line2"
                  type="text"
                  autocomplete="address-line2"
                />
              </div>

              <div class="field">
                <label class="field-label" for="order-suburb">Suburb</label>
                <input
                  class="field-input"
                  id="order-suburb"
                  name="address_suburb"
                  type="text"
                  aria-describedby="order-suburb-error"
                />
                <p
                  class="field-error"
                  id="order-suburb-error"
                  data-error
                  hidden
                />
              </div>

              <div class="field">
                <label class="field-label" for="order-city">City or town</label>
                <input
                  class="field-input"
                  id="order-city"
                  name="address_city"
                  type="text"
                  autocomplete="address-level2"
                  aria-describedby="order-city-error"
                />
                <p
                  class="field-error"
                  id="order-city-error"
                  data-error
                  hidden
                />
              </div>

              <div class="field">
                <label class="field-label" for="order-province">Province</label>
                <select
                  class="field-input"
                  id="order-province"
                  name="address_province"
                  autocomplete="address-level1"
                  aria-describedby="order-province-error"
                >
                  <option value="" selected disabled>
                    Choose a province
                  </option>
                  {SA_PROVINCES.map((province) => (
                    <option value={province}>{province}</option>
                  ))}
                </select>
                <p
                  class="field-error"
                  id="order-province-error"
                  data-error
                  hidden
                />
              </div>

              <div class="field">
                <label class="field-label" for="order-postal">
                  Postal code
                </label>
                <input
                  class="field-input"
                  id="order-postal"
                  name="address_postal"
                  type="text"
                  inputmode="numeric"
                  autocomplete="postal-code"
                  maxlength="4"
                  aria-describedby="order-postal-error"
                />
                <p
                  class="field-error"
                  id="order-postal-error"
                  data-error
                  hidden
                />
              </div>
            </fieldset>

            <p class="order-total" data-total-row hidden>
              <span class="field-label">Order total</span>
              <span class="tabular text-accent" data-total></span>
            </p>

            {/* Advisory error summary; announced politely, never colour-only. */}
            <p class="sr-only" role="status" aria-live="polite" data-status></p>

            <div class="order-actions">
              <button type="submit" class="btn">Place order</button>
              <p class="field-hint">
                We don't take card details on this site. Payment is EFT or
                PayShap after we confirm.
              </p>
            </div>

            <noscript>
              <p class="field-hint order-noscript">
                Submitting opens your email app with the order pre-filled — send
                it and we'll reply with a reference and payment details. Then see
                <a href="/order/confirmation">payment instructions</a>.
              </p>
            </noscript>
          </form>
        )
      }

      {/* Revealed by the island after a successful hand-off. */}
      <div class="order-success" data-success hidden>
        <h2 class="order-success-heading" data-success-heading tabindex="-1"></h2>
        <p class="measure text-ink-muted">
          We've opened WhatsApp so you can send us the order. If it didn't open,
          use the button below — or email it instead.
        </p>
        <div class="order-actions">
          <a class="btn" data-success-whatsapp href="#" target="_blank" rel="noopener">
            Send order on WhatsApp
          </a>
          <a class="text-btn" data-success-mailto href="#">Email the order</a>
        </div>
        <p class="measure">
          <a data-success-continue href="/order/confirmation">
            Continue to payment instructions →
          </a>
        </p>
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  import {
    confirmationPath,
    generateReference,
    isReferenceShaped,
    mailtoOrderUrl,
    submitOrder,
    whatsappOrderUrl,
    type DeliveryAddress,
    type Order,
    type OrderProduct,
    type SaProvince,
  } from "../../lib/orders";
  import { formatZAR } from "../../lib/format-zar";

  let controller: AbortController | undefined;

  const EMAIL_RE = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
  const POSTAL_RE = /^\d{4}$/;

  function el<T extends Element>(root: ParentNode, selector: string): T | null {
    return root.querySelector<T>(selector);
  }

  function optionData(option: HTMLOptionElement | null): OrderProduct | null {
    if (!option || !option.value) {
      return null;
    }
    const title = option.dataset.title;
    const price = Number(option.dataset.price);
    const kind = option.dataset.kind;
    if (!title || !Number.isInteger(price) || (kind !== "digital" && kind !== "physical")) {
      return null;
    }
    return { slug: option.value, title, priceCents: price, kind };
  }

  function setError(
    field: HTMLElement,
    input: HTMLInputElement | HTMLSelectElement,
    message: string,
  ): void {
    input.setAttribute("aria-invalid", "true");
    const node = el<HTMLElement>(field, "[data-error]");
    if (node) {
      node.textContent = message;
      node.hidden = false;
    }
  }

  function clearError(
    field: HTMLElement,
    input: HTMLInputElement | HTMLSelectElement,
  ): void {
    input.removeAttribute("aria-invalid");
    const node = el<HTMLElement>(field, "[data-error]");
    if (node) {
      node.textContent = "";
      node.hidden = true;
    }
  }

  function init(): void {
    controller?.abort();
    const form = document.getElementById("order-form");
    if (!(form instanceof HTMLFormElement)) {
      return;
    }
    controller = new AbortController();
    const { signal } = controller;

    // The island owns validation now; let the native layer stand down.
    form.noValidate = true;

    const select = el<HTMLSelectElement>(form, "#order-product");
    const selectField = el<HTMLElement>(form, "[data-product-select-field]");
    const locked = el<HTMLElement>(form, "[data-product-locked]");
    const lockedTitle = el<HTMLElement>(form, "[data-product-locked-title]");
    const lockedInput = el<HTMLInputElement>(form, "[data-product-locked-input]");
    const changeBtn = el<HTMLButtonElement>(form, "[data-product-change]");
    const address = el<HTMLElement>(form, "[data-address]");
    const totalRow = el<HTMLElement>(form, "[data-total-row]");
    const totalOut = el<HTMLElement>(form, "[data-total]");
    const status = el<HTMLElement>(form, "[data-status]");
    const quantityInput = el<HTMLInputElement>(form, "#order-quantity");

    // Reference: generate once per load, show it, carry it in a hidden input.
    const reference = generateReference();
    const refPanel = el<HTMLElement>(form, "[data-ref-panel]");
    const refValue = el<HTMLElement>(form, "[data-ref-value]");
    const refInput = el<HTMLInputElement>(form, "[data-ref-input]");
    if (refPanel && refValue && refInput) {
      refValue.textContent = reference;
      refInput.value = reference;
      refPanel.hidden = false;
    }

    const currentProduct = (): OrderProduct | null => {
      if (locked && !locked.hidden && lockedInput) {
        const opt = select?.querySelector<HTMLOptionElement>(
          `option[value="${lockedInput.value}"]`,
        );
        return optionData(opt ?? null);
      }
      return optionData(select?.selectedOptions[0] ?? null);
    };

    const refreshDerived = (): void => {
      const product = currentProduct();
      const isPhysical = product?.kind === "physical";
      if (address) {
        address.hidden = !isPhysical;
      }
      const qty = Math.max(1, Math.trunc(Number(quantityInput?.value ?? "1")));
      if (product && totalRow && totalOut) {
        totalOut.textContent = formatZAR(product.priceCents * qty);
        totalRow.hidden = false;
      } else if (totalRow) {
        totalRow.hidden = true;
      }
    };

    const lockProduct = (slug: string): void => {
      const opt = select?.querySelector<HTMLOptionElement>(
        `option[value="${slug}"]`,
      );
      const product = optionData(opt ?? null);
      if (!product || !select || !selectField || !locked || !lockedTitle || !lockedInput) {
        return;
      }
      select.value = slug;
      select.disabled = true;
      selectField.hidden = true;
      lockedTitle.textContent = `${product.title} — ${formatZAR(product.priceCents)}`;
      lockedInput.value = slug;
      locked.hidden = false;
      refreshDerived();
    };

    const unlockProduct = (): void => {
      if (!select || !selectField || !locked) {
        return;
      }
      select.disabled = false;
      selectField.hidden = false;
      locked.hidden = true;
      select.focus();
      refreshDerived();
    };

    // Prefill + lock from ?product=, when it names a live option.
    const requested = new URLSearchParams(location.search).get("product");
    if (
      requested &&
      select?.querySelector(`option[value="${CSS.escape(requested)}"]`)
    ) {
      lockProduct(requested);
    }

    select?.addEventListener("change", refreshDerived, { signal });
    quantityInput?.addEventListener("input", refreshDerived, { signal });
    changeBtn?.addEventListener("click", unlockProduct, { signal });
    refreshDerived();

    const readAddress = (): DeliveryAddress => ({
      line1: (el<HTMLInputElement>(form, "#order-line1")?.value ?? "").trim(),
      line2: (el<HTMLInputElement>(form, "#order-line2")?.value ?? "").trim(),
      suburb: (el<HTMLInputElement>(form, "#order-suburb")?.value ?? "").trim(),
      city: (el<HTMLInputElement>(form, "#order-city")?.value ?? "").trim(),
      province: (el<HTMLSelectElement>(form, "#order-province")?.value ??
        "") as SaProvince | "",
      postalCode: (el<HTMLInputElement>(form, "#order-postal")?.value ?? "").trim(),
    });

    interface Check {
      selector: string;
      ok: (value: string) => boolean;
      message: string;
    }

    const validate = (): { order: Order | null; firstInvalid: HTMLElement | null } => {
      let firstInvalid: HTMLElement | null = null;
      const product = currentProduct();

      const fail = (input: HTMLInputElement | HTMLSelectElement, message: string): void => {
        const field = input.closest<HTMLElement>(".field, [data-product-select-field]");
        if (field) {
          setError(field, input, message);
          firstInvalid ??= input;
        }
      };

      const checks: Check[] = [
        {
          selector: "#order-name",
          ok: (v) => v.trim().length > 0,
          message: "Enter the name the order should be in.",
        },
        {
          selector: "#order-email",
          ok: (v) => EMAIL_RE.test(v.trim()),
          message: "Enter a valid email so we can send the files and confirm.",
        },
        {
          selector: "#order-whatsapp",
          ok: (v) => v.replace(/\D/g, "").length >= 9,
          message: "Enter a WhatsApp number, including the area or country code.",
        },
        {
          selector: "#order-quantity",
          ok: (v) => Number.isInteger(Number(v)) && Number(v) >= 1,
          message: "Quantity must be a whole number, one or more.",
        },
      ];

      for (const check of checks) {
        const input = el<HTMLInputElement>(form, check.selector);
        if (!input) {
          continue;
        }
        const field = input.closest<HTMLElement>(".field");
        if (!field) {
          continue;
        }
        if (check.ok(input.value)) {
          clearError(field, input);
        } else {
          setError(field, input, check.message);
          firstInvalid ??= input;
        }
      }

      // Product
      if (!product) {
        const input = select;
        if (input) {
          fail(input, "Choose a product to order.");
        }
      } else if (select) {
        const field = select.closest<HTMLElement>(".field");
        if (field) {
          clearError(field, select);
        }
      }

      // Address, physical only
      let address: DeliveryAddress | null = null;
      if (product?.kind === "physical") {
        const a = readAddress();
        const addressChecks: { selector: string; ok: boolean; message: string }[] = [
          { selector: "#order-line1", ok: a.line1.length > 0, message: "Enter a street address." },
          { selector: "#order-suburb", ok: a.suburb.length > 0, message: "Enter a suburb." },
          { selector: "#order-city", ok: a.city.length > 0, message: "Enter a city or town." },
          { selector: "#order-province", ok: a.province.length > 0, message: "Choose a province." },
          {
            selector: "#order-postal",
            ok: POSTAL_RE.test(a.postalCode),
            message: "Enter a four-digit postal code.",
          },
        ];
        for (const check of addressChecks) {
          const input = el<HTMLInputElement | HTMLSelectElement>(form, check.selector);
          if (!input) {
            continue;
          }
          const field = input.closest<HTMLElement>(".field");
          if (!field) {
            continue;
          }
          if (check.ok) {
            clearError(field, input);
          } else {
            setError(field, input, check.message);
            firstInvalid ??= input;
          }
        }
        address = a;
      }

      if (firstInvalid || !product) {
        return { order: null, firstInvalid };
      }

      const nameEl = el<HTMLInputElement>(form, "#order-name");
      const emailEl = el<HTMLInputElement>(form, "#order-email");
      const waEl = el<HTMLInputElement>(form, "#order-whatsapp");
      const order: Order = {
        reference,
        name: (nameEl?.value ?? "").trim(),
        email: (emailEl?.value ?? "").trim(),
        whatsapp: (waEl?.value ?? "").trim(),
        quantity: Math.trunc(Number(quantityInput?.value ?? "1")),
        product,
        address,
      };
      return { order, firstInvalid: null };
    };

    const announce = (message: string): void => {
      if (status) {
        status.textContent = message;
      }
    };

    const showSuccess = (order: Order): void => {
      const success = document.querySelector<HTMLElement>("[data-success]");
      if (!success) {
        return;
      }
      form.hidden = true;
      const heading = el<HTMLElement>(success, "[data-success-heading]");
      const wa = el<HTMLAnchorElement>(success, "[data-success-whatsapp]");
      const mail = el<HTMLAnchorElement>(success, "[data-success-mailto]");
      const cont = el<HTMLAnchorElement>(success, "[data-success-continue]");
      if (heading) {
        heading.textContent = `Order ${order.reference} is ready`;
      }
      if (wa) {
        wa.href = whatsappOrderUrl(order);
      }
      if (mail) {
        mail.href = mailtoOrderUrl(order);
      }
      if (cont && isReferenceShaped(order.reference)) {
        cont.href = confirmationPath(order.reference);
      }
      success.hidden = false;
      heading?.focus();
      announce(`Order ${order.reference} prepared. Send it on WhatsApp or email to confirm.`);
    };

    form.addEventListener(
      "submit",
      (event) => {
        event.preventDefault();
        const { order, firstInvalid } = validate();
        if (!order) {
          const count =
            form.querySelectorAll("[data-error]:not([hidden])").length;
          announce(
            `${String(count)} field${count === 1 ? "" : "s"} need${count === 1 ? "s" : ""} attention.`,
          );
          firstInvalid?.focus();
          return;
        }
        void submitOrder(order)
          .then(() => {
            showSuccess(order);
          })
          .catch(() => {
            announce(
              "Something went wrong opening WhatsApp. Use the email option, or try again.",
            );
          });
      },
      { signal },
    );
  }

  init();
  document.addEventListener("astro:page-load", init);
</script>

<style>
  .order-layout {
    display: flex;
    flex-direction: column;
    gap: var(--space-12);
  }

  .order-form {
    display: flex;
    flex-direction: column;
    gap: var(--space-8);
    max-width: var(--measure-body);
  }

  .order-ref-panel {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    padding: var(--space-6);
    background-color: var(--color-surface-raised);
    border: var(--size-hairline) solid var(--color-hairline);
  }

  .order-ref-value {
    font-size: var(--text-xl);
    font-weight: 600;
    color: var(--color-accent);
  }

  .order-address {
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
    margin: 0;
    padding: var(--space-6);
    border: var(--size-hairline) solid var(--color-hairline);
  }

  .order-address legend {
    padding-inline: var(--space-2);
  }

  .order-locked {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    padding: var(--space-6);
    background-color: var(--color-surface-raised);
    border: var(--size-hairline) solid var(--color-hairline);
  }

  .order-locked-title {
    font-size: var(--text-lg);
  }

  .order-total {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-4);
    padding-block: var(--space-4);
    border-top: var(--size-hairline) solid var(--color-hairline);
  }

  .order-total .tabular {
    font-size: var(--text-lg);
    font-weight: 600;
  }

  .order-actions {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    align-items: flex-start;
  }

  .order-noscript {
    padding: var(--space-4);
    border: var(--size-hairline) solid var(--color-hairline);
  }

  .order-success {
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
    max-width: var(--measure-body);
  }

  .order-success-heading {
    outline: none;
  }
</style>
