---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { formatZAR } from "../../lib/format-zar";
import {
  NAME_MAX,
  NOTES_MAX,
  QTY_MAX,
  QTY_MIN,
  SA_PROVINCES,
} from "../../lib/orders";
import { CONTACT } from "../../lib/site";

// Only in-stock products can be ordered. Out-of-stock and sold-out listings
// still render fully on the store, with an honest sentence instead of a button.
const orderable = (await getCollection("products"))
  .filter((product) => product.data.stock === "in-stock")
  .toSorted((a, b) => a.data.order - b.data.order);
---

<BaseLayout
  title="Place an order — Foreverlikethemoon"
  description="Order a wedding planner. Pay by EFT or SnapScan once your order reference arrives."
>
  <section class="band" aria-labelledby="order-heading">
    <div class="section-inner flex flex-col gap-16">
      <header class="flex flex-col gap-6">
        <p class="eyebrow">Order</p>
        <h1 id="order-heading">Place an order</h1>
        <p class="measure lead text-ink-muted">
          Nothing is charged on this page. Once you place the order you get a
          reference and our banking details, and you pay by EFT or SnapScan.
        </p>
      </header>

      {
        orderable.length === 0 ? (
          <p class="measure" role="status">
            Nothing is available to order right now.{" "}
            <a href="/store">See the store</a> for what's coming, or{" "}
            <a href={`mailto:${CONTACT.email}`}>email us</a> to hear when a
            product is back.
          </p>
        ) : (
          <div class="order-layout">
            <form id="order-form" class="order-form" novalidate>
              <div
                class="form-alert"
                role="alert"
                tabindex="-1"
                data-alert
                hidden
              >
                <p class="form-alert__title" data-alert-title />
                <ul class="form-alert__list" data-alert-list />
              </div>

              <fieldset class="form-group">
                <legend class="eyebrow">Your order</legend>

                <div class="field" data-field="product">
                  <label class="field-label" for="order-product">
                    Product
                  </label>
                  <select
                    class="field-input"
                    id="order-product"
                    name="product_id"
                    required
                    aria-describedby="order-product-error"
                  >
                    {orderable.length > 1 && (
                      <option value="" selected disabled>
                        Choose a product
                      </option>
                    )}
                    {orderable.map((product) => (
                      <option
                        value={product.data.slug}
                        data-title={product.data.title}
                        data-price={String(product.data.price)}
                        data-kind={product.data.kind}
                      >
                        {product.data.title} — {formatZAR(product.data.price)}
                      </option>
                    ))}
                  </select>
                  <p
                    class="field-error"
                    id="order-product-error"
                    data-error
                    hidden
                  />
                </div>

                <div class="field field-narrow" data-field="qty">
                  <label class="field-label" for="order-qty">
                    Quantity
                  </label>
                  <input
                    class="field-input tabular"
                    id="order-qty"
                    name="qty"
                    type="number"
                    min={QTY_MIN}
                    max={QTY_MAX}
                    step="1"
                    value="1"
                    inputmode="numeric"
                    required
                    aria-describedby="order-qty-error"
                  />
                  <p
                    class="field-error"
                    id="order-qty-error"
                    data-error
                    hidden
                  />
                </div>
              </fieldset>

              <fieldset class="form-group">
                <legend class="eyebrow">Your details</legend>

                <div class="field" data-field="name">
                  <label class="field-label" for="order-name">
                    Full name
                  </label>
                  <input
                    class="field-input"
                    id="order-name"
                    name="customer_name"
                    type="text"
                    autocomplete="name"
                    maxlength={NAME_MAX}
                    required
                    aria-describedby="order-name-error"
                  />
                  <p
                    class="field-error"
                    id="order-name-error"
                    data-error
                    hidden
                  />
                </div>

                <div class="field" data-field="email">
                  <label class="field-label" for="order-email">
                    Email
                  </label>
                  <input
                    class="field-input"
                    id="order-email"
                    name="customer_email"
                    type="email"
                    autocomplete="email"
                    inputmode="email"
                    required
                    aria-describedby="order-email-hint order-email-error"
                  />
                  <p class="field-hint" id="order-email-hint">
                    Your invoice goes here, and so does the planner file.
                  </p>
                  <p
                    class="field-error"
                    id="order-email-error"
                    data-error
                    hidden
                  />
                </div>

                <div class="field" data-field="whatsapp">
                  <label class="field-label" for="order-whatsapp">
                    WhatsApp number <span class="field-optional">optional</span>
                  </label>
                  <input
                    class="field-input"
                    id="order-whatsapp"
                    name="whatsapp"
                    type="tel"
                    autocomplete="tel"
                    inputmode="tel"
                    aria-describedby="order-whatsapp-hint order-whatsapp-error"
                  />
                  <p class="field-hint" id="order-whatsapp-hint">
                    Only if you'd like order updates on WhatsApp.
                  </p>
                  <p
                    class="field-error"
                    id="order-whatsapp-error"
                    data-error
                    hidden
                  />
                </div>
              </fieldset>

              <fieldset class="form-group" data-address hidden>
                <legend class="eyebrow">Delivery address</legend>
                <p class="field-hint">
                  We courier within South Africa. A flat delivery fee is added
                  to physical orders.
                </p>

                <div class="field" data-field="line1">
                  <label class="field-label" for="order-line1">
                    Street address
                  </label>
                  <input
                    class="field-input"
                    id="order-line1"
                    type="text"
                    autocomplete="address-line1"
                    aria-describedby="order-line1-error"
                  />
                  <p
                    class="field-error"
                    id="order-line1-error"
                    data-error
                    hidden
                  />
                </div>

                <div class="field" data-field="line2">
                  <label class="field-label" for="order-line2">
                    Apartment, complex or unit{" "}
                    <span class="field-optional">optional</span>
                  </label>
                  <input
                    class="field-input"
                    id="order-line2"
                    type="text"
                    autocomplete="address-line2"
                  />
                </div>

                <div class="field-row">
                  <div class="field" data-field="suburb">
                    <label class="field-label" for="order-suburb">
                      Suburb
                    </label>
                    <input
                      class="field-input"
                      id="order-suburb"
                      type="text"
                      autocomplete="address-level3"
                      aria-describedby="order-suburb-error"
                    />
                    <p
                      class="field-error"
                      id="order-suburb-error"
                      data-error
                      hidden
                    />
                  </div>

                  <div class="field" data-field="city">
                    <label class="field-label" for="order-city">
                      City or town
                    </label>
                    <input
                      class="field-input"
                      id="order-city"
                      type="text"
                      autocomplete="address-level2"
                      aria-describedby="order-city-error"
                    />
                    <p
                      class="field-error"
                      id="order-city-error"
                      data-error
                      hidden
                    />
                  </div>
                </div>

                <div class="field-row">
                  <div class="field" data-field="province">
                    <label class="field-label" for="order-province">
                      Province
                    </label>
                    <select
                      class="field-input"
                      id="order-province"
                      autocomplete="address-level1"
                      aria-describedby="order-province-error"
                    >
                      <option value="" selected disabled>
                        Choose a province
                      </option>
                      {SA_PROVINCES.map((province) => (
                        <option value={province}>{province}</option>
                      ))}
                    </select>
                    <p
                      class="field-error"
                      id="order-province-error"
                      data-error
                      hidden
                    />
                  </div>

                  <div class="field" data-field="postal">
                    <label class="field-label" for="order-postal">
                      Postal code
                    </label>
                    <input
                      class="field-input tabular"
                      id="order-postal"
                      type="text"
                      inputmode="numeric"
                      autocomplete="postal-code"
                      maxlength="4"
                      aria-describedby="order-postal-error"
                    />
                    <p
                      class="field-error"
                      id="order-postal-error"
                      data-error
                      hidden
                    />
                  </div>
                </div>
              </fieldset>

              <div class="field" data-field="notes">
                <label class="field-label" for="order-notes">
                  Notes <span class="field-optional">optional</span>
                </label>
                <textarea
                  class="field-input field-textarea"
                  id="order-notes"
                  name="notes"
                  rows="4"
                  maxlength={NOTES_MAX - 40}
                  aria-describedby="order-notes-error"
                />
                <p
                  class="field-error"
                  id="order-notes-error"
                  data-error
                  hidden
                />
              </div>

              <div class="field" data-field="turnstile">
                <p class="field-label" id="order-turnstile-label">
                  Security check
                </p>
                <div
                  class="turnstile-slot"
                  data-turnstile
                  aria-labelledby="order-turnstile-label"
                  role="group"
                />
                <p class="field-hint" data-turnstile-status>
                  Loading the security check…
                </p>
                <p
                  class="field-error"
                  id="order-turnstile-error"
                  data-error
                  hidden
                />
              </div>

              <div class="order-actions">
                <button type="submit" class="btn" data-submit>
                  Place order
                </button>
                <p class="field-hint">
                  We never ask for card details. By ordering you agree to our{" "}
                  <a href="/terms">terms</a> and{" "}
                  <a href="/refunds">refund policy</a>.
                </p>
              </div>

              <p class="sr-only" role="status" aria-live="polite" data-status />

              <noscript>
                <p class="noscript-note">
                  Ordering needs JavaScript for the security check. If it's
                  switched off, email{" "}
                  <a href={`mailto:${CONTACT.email}`}>{CONTACT.email}</a> or
                  WhatsApp{" "}
                  <a href={CONTACT.phoneHref}>{CONTACT.phoneDisplay}</a> and
                  we'll take your order by hand.
                </p>
              </noscript>
            </form>

            <aside class="order-summary" aria-labelledby="summary-heading">
              <h2 id="summary-heading" class="eyebrow">
                Summary
              </h2>
              <dl class="summary-list tabular">
                <div class="summary-row">
                  <dt data-summary-product>—</dt>
                  <dd data-summary-line>—</dd>
                </div>
                <div class="summary-row" data-summary-shipping-row hidden>
                  <dt>Delivery, flat fee</dt>
                  <dd data-summary-shipping>—</dd>
                </div>
                <div class="summary-row summary-total">
                  <dt>Total</dt>
                  <dd data-summary-total>—</dd>
                </div>
              </dl>
              <p class="field-hint">
                The shop prices every order itself, so the invoice in your inbox
                is the final word on the amount.
              </p>
            </aside>
          </div>
        )
      }
    </div>
  </section>
</BaseLayout>

<script>
  import { formatZAR } from "../../lib/format-zar";
  import {
    ADDRESS_MAX,
    EMAIL_MAX,
    EMAIL_PATTERN,
    NAME_MAX,
    NOTES_MAX,
    QTY_MAX,
    QTY_MIN,
    composeNotes,
    confirmationPath,
    fetchConfig,
    formatAddress,
    isReference,
    placeOrder,
    randsToCents,
    rememberPlaced,
    type ApiConfig,
    type DeliveryAddress,
    type OrderRequest,
    type SaProvince,
  } from "../../lib/orders";
  import { loadTurnstile, type TurnstileApi } from "../../lib/turnstile";

  type FieldKey =
    | "product"
    | "qty"
    | "name"
    | "email"
    | "whatsapp"
    | "line1"
    | "suburb"
    | "city"
    | "province"
    | "postal"
    | "notes"
    | "turnstile";

  interface FieldError {
    field: FieldKey;
    message: string;
  }

  // The server answers with one sentence; route the ones we recognise to the
  // field they belong to so the buyer sees it where they need to fix it.
  const SERVER_FIELD: Record<string, FieldKey> = {
    "Choose a product": "product",
    "Enter a quantity from 1 to 99": "qty",
    "Enter your name": "name",
    "Enter a valid email address": "email",
    "Enter a delivery address": "line1",
    "Enter a shorter delivery address": "line1",
    "Notes are too long": "notes",
    "Turnstile check failed": "turnstile",
  };

  const FRIENDLY: Partial<Record<string, string>> = {
    "Turnstile check failed":
      "The security check didn't go through. Please complete it again.",
  };

  let teardown: (() => void) | undefined;

  function q<T extends Element>(root: ParentNode, selector: string): T | null {
    return root.querySelector<T>(selector);
  }

  function init(): void {
    teardown?.();
    teardown = undefined;
    const form = document.getElementById("order-form");
    if (!(form instanceof HTMLFormElement)) return;

    const controller = new AbortController();
    const { signal } = controller;
    let turnstile: TurnstileApi | undefined;
    let widgetId: string | undefined;
    let token = "";
    let config: ApiConfig | undefined;
    let submitting = false;

    teardown = () => {
      controller.abort();
      if (turnstile && widgetId) turnstile.remove(widgetId);
    };

    const select = q<HTMLSelectElement>(form, "#order-product");
    const qtyInput = q<HTMLInputElement>(form, "#order-qty");
    const address = q<HTMLElement>(form, "[data-address]");
    const submit = q<HTMLButtonElement>(form, "[data-submit]");
    const status = q<HTMLElement>(form, "[data-status]");
    const alertBox = q<HTMLElement>(form, "[data-alert]");
    const alertTitle = q<HTMLElement>(form, "[data-alert-title]");
    const alertList = q<HTMLUListElement>(form, "[data-alert-list]");
    const slot = q<HTMLElement>(form, "[data-turnstile]");
    const turnstileStatus = q<HTMLElement>(form, "[data-turnstile-status]");
    const summary = document.querySelector<HTMLElement>(".order-summary");

    const value = (selector: string): string =>
      (
        q<HTMLInputElement | HTMLSelectElement | HTMLTextAreaElement>(
          form,
          selector,
        )?.value ?? ""
      ).trim();

    const control = (field: FieldKey): HTMLElement | null =>
      q<HTMLElement>(
        form,
        `[data-field="${field}"] .field-input, [data-field="${field}"] [data-turnstile]`,
      );

    const selectedOption = (): HTMLOptionElement | null => {
      const option = select?.selectedOptions[0] ?? null;
      return option && option.value ? option : null;
    };

    const isPhysical = (): boolean =>
      selectedOption()?.dataset.kind === "physical";

    const quantity = (): number => Number(qtyInput?.value ?? "");

    // Display only. The server prices the order; these numbers come from the
    // same catalogue (a test fails the build if the two drift).
    const renderSummary = (): void => {
      if (!summary) return;
      const option = selectedOption();
      const productOut = q<HTMLElement>(summary, "[data-summary-product]");
      const lineOut = q<HTMLElement>(summary, "[data-summary-line]");
      const shipRow = q<HTMLElement>(summary, "[data-summary-shipping-row]");
      const shipOut = q<HTMLElement>(summary, "[data-summary-shipping]");
      const totalOut = q<HTMLElement>(summary, "[data-summary-total]");
      const qty = quantity();
      const qtyOk = Number.isInteger(qty) && qty >= QTY_MIN && qty <= QTY_MAX;
      const unit = Number(option?.dataset.price);
      if (!option || !Number.isInteger(unit) || !qtyOk) {
        if (productOut) productOut.textContent = option?.dataset.title ?? "—";
        if (lineOut) lineOut.textContent = "—";
        if (totalOut) totalOut.textContent = "—";
        if (shipRow) shipRow.hidden = true;
        return;
      }
      const shipping =
        isPhysical() && config ? randsToCents(config.shippingFlatZar) : 0;
      if (productOut) {
        productOut.textContent = `${option.dataset.title ?? ""} × ${String(qty)}`;
      }
      if (lineOut) lineOut.textContent = formatZAR(unit * qty);
      if (shipRow) shipRow.hidden = !isPhysical();
      if (shipOut) {
        shipOut.textContent = config ? formatZAR(shipping) : "—";
      }
      if (totalOut) {
        totalOut.textContent =
          isPhysical() && !config ? "—" : formatZAR(unit * qty + shipping);
      }
    };

    const refreshDerived = (): void => {
      if (address) address.hidden = !isPhysical();
      renderSummary();
    };

    const setFieldError = (field: FieldKey, message: string | null): void => {
      const wrap = q<HTMLElement>(form, `[data-field="${field}"]`);
      if (!wrap) return;
      const input = control(field);
      const error = q<HTMLElement>(wrap, "[data-error]");
      if (message) {
        input?.setAttribute("aria-invalid", "true");
        if (error) {
          error.textContent = message;
          error.hidden = false;
        }
      } else {
        input?.removeAttribute("aria-invalid");
        if (error) {
          error.textContent = "";
          error.hidden = true;
        }
      }
    };

    const clearAlert = (): void => {
      if (alertBox) alertBox.hidden = true;
      if (alertList) alertList.replaceChildren();
    };

    const showAlert = (title: string, errors: FieldError[]): void => {
      if (!alertBox || !alertTitle || !alertList) return;
      alertTitle.textContent = title;
      alertList.replaceChildren(
        ...errors.map((error) => {
          const item = document.createElement("li");
          const target = control(error.field);
          if (target?.id) {
            const link = document.createElement("a");
            link.href = `#${target.id}`;
            link.textContent = error.message;
            link.addEventListener("click", (event) => {
              event.preventDefault();
              target.focus();
            });
            item.append(link);
          } else {
            item.textContent = error.message;
          }
          return item;
        }),
      );
      alertList.hidden = errors.length === 0;
      alertBox.hidden = false;
      alertBox.focus();
    };

    const readAddress = (): DeliveryAddress => ({
      line1: value("#order-line1"),
      line2: value("#order-line2"),
      suburb: value("#order-suburb"),
      city: value("#order-city"),
      province: value("#order-province") as SaProvince | "",
      postalCode: value("#order-postal"),
    });

    const validate = (): { errors: FieldError[]; order?: OrderRequest } => {
      const errors: FieldError[] = [];
      const option = selectedOption();
      if (!option) {
        errors.push({ field: "product", message: "Choose a product." });
      }
      const qty = quantity();
      if (!Number.isInteger(qty) || qty < QTY_MIN || qty > QTY_MAX) {
        errors.push({
          field: "qty",
          message: `Enter a quantity from ${String(QTY_MIN)} to ${String(QTY_MAX)}.`,
        });
      }
      const name = value("#order-name");
      if (!name) {
        errors.push({ field: "name", message: "Enter your full name." });
      } else if (name.length > NAME_MAX) {
        errors.push({ field: "name", message: "That name is too long." });
      }
      const email = value("#order-email");
      if (!EMAIL_PATTERN.test(email) || email.length > EMAIL_MAX) {
        errors.push({
          field: "email",
          message: "Enter an email address like name@example.com.",
        });
      }
      const whatsapp = value("#order-whatsapp");
      if (whatsapp && whatsapp.replace(/\D/g, "").length < 9) {
        errors.push({
          field: "whatsapp",
          message: "Enter the full number, including the area code.",
        });
      }

      let deliveryAddress = "";
      if (option && isPhysical()) {
        const a = readAddress();
        if (!a.line1) {
          errors.push({ field: "line1", message: "Enter a street address." });
        }
        if (!a.suburb) {
          errors.push({ field: "suburb", message: "Enter a suburb." });
        }
        if (!a.city) {
          errors.push({ field: "city", message: "Enter a city or town." });
        }
        if (!a.province) {
          errors.push({ field: "province", message: "Choose a province." });
        }
        if (!/^\d{4}$/.test(a.postalCode)) {
          errors.push({
            field: "postal",
            message: "Enter a four-digit postal code.",
          });
        }
        deliveryAddress = formatAddress(a);
        if (deliveryAddress.length > ADDRESS_MAX) {
          errors.push({
            field: "line1",
            message: "That address is too long. Please shorten it.",
          });
        }
      }

      const notes = composeNotes(whatsapp, value("#order-notes"));
      if (notes.length > NOTES_MAX) {
        errors.push({ field: "notes", message: "Please shorten your notes." });
      }

      if (!token) {
        errors.push({
          field: "turnstile",
          message: turnstile
            ? "Complete the security check."
            : "The security check hasn't loaded yet. Wait a moment and try again.",
        });
      }

      const fields: FieldKey[] = [
        "product",
        "qty",
        "name",
        "email",
        "whatsapp",
        "line1",
        "suburb",
        "city",
        "province",
        "postal",
        "notes",
        "turnstile",
      ];
      for (const field of fields) {
        setFieldError(
          field,
          errors.find((error) => error.field === field)?.message ?? null,
        );
      }

      if (errors.length > 0 || !option) return { errors };
      return {
        errors,
        order: {
          product_id: option.value,
          qty,
          customer_name: name,
          customer_email: email,
          ...(deliveryAddress ? { delivery_address: deliveryAddress } : {}),
          ...(notes ? { notes } : {}),
          turnstile_token: token,
        },
      };
    };

    const resetTurnstile = (): void => {
      token = "";
      if (turnstile && widgetId) turnstile.reset(widgetId);
    };

    const setBusy = (busy: boolean): void => {
      submitting = busy;
      if (submit) {
        submit.disabled = busy;
        submit.textContent = busy ? "Placing order…" : "Place order";
      }
      form.setAttribute("aria-busy", String(busy));
    };

    // Prefill from ?product= when it names a live option.
    const requested = new URLSearchParams(location.search).get("product");
    if (
      requested &&
      select?.querySelector(`option[value="${CSS.escape(requested)}"]`)
    ) {
      select.value = requested;
    }

    select?.addEventListener("change", refreshDerived, { signal });
    qtyInput?.addEventListener("input", refreshDerived, { signal });
    refreshDerived();

    void fetchConfig().then(async (result) => {
      if (signal.aborted) return;
      if (!result.ok || !result.data.turnstileSiteKey) {
        if (turnstileStatus) {
          turnstileStatus.textContent =
            "The security check couldn't load. Refresh the page, or email us to order by hand.";
        }
        return;
      }
      config = result.data;
      renderSummary();
      try {
        turnstile = await loadTurnstile();
      } catch {
        if (turnstileStatus) {
          turnstileStatus.textContent =
            "The security check couldn't load. A content blocker may be stopping it.";
        }
        return;
      }
      if (signal.aborted || !slot) return;
      widgetId = turnstile.render(slot, {
        sitekey: config.turnstileSiteKey,
        action: "order",
        theme: "auto",
        size: "flexible",
        callback: (value) => {
          token = value;
          setFieldError("turnstile", null);
        },
        "expired-callback": () => {
          token = "";
        },
        "error-callback": () => {
          token = "";
        },
      });
      if (turnstileStatus) turnstileStatus.hidden = true;
    });

    form.addEventListener(
      "submit",
      (event) => {
        event.preventDefault();
        if (submitting) return;
        clearAlert();
        const { errors, order } = validate();
        if (!order) {
          showAlert(
            errors.length === 1
              ? "One thing needs fixing before we can place the order:"
              : `${String(errors.length)} things need fixing before we can place the order:`,
            errors,
          );
          return;
        }

        setBusy(true);
        if (status) status.textContent = "Placing your order…";
        void placeOrder(order).then((result) => {
          if (signal.aborted) return;
          if (result.ok && isReference(result.data.reference)) {
            rememberPlaced(result.data);
            if (status) {
              status.textContent = `Order ${result.data.reference} placed.`;
            }
            location.assign(confirmationPath(result.data.reference));
            return;
          }
          setBusy(false);
          // A Turnstile token is single-use: whatever went wrong, get a new one.
          resetTurnstile();
          const message = result.ok
            ? "The order went through but we couldn't read the reference. Check your email before ordering again."
            : (FRIENDLY[result.error] ?? result.error);
          const field = result.ok ? undefined : SERVER_FIELD[result.error];
          if (field) setFieldError(field, message);
          showAlert(
            result.ok || (result.status >= 500 && !field)
              ? "We couldn't place your order."
              : "Please check your order:",
            [{ field: field ?? "turnstile", message }],
          );
          if (status) status.textContent = message;
        });
      },
      { signal },
    );
  }

  init();
  document.addEventListener("astro:page-load", init);
  document.addEventListener("astro:before-swap", () => {
    teardown?.();
    teardown = undefined;
  });
</script>

