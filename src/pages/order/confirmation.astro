---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { CONTACT } from "../../lib/site";

// Static shell. Everything order-specific is read at runtime from
// GET /api/summary/{ref} and GET /api/config. The URL carries the reference
// and nothing else.
---

<BaseLayout
  title="Your order — Foreverlikethemoon"
  description="Your order reference and how to pay."
  noindex
>
  <section class="band" aria-labelledby="confirmation-heading">
    <div class="section-inner conf-stack">
      <header class="flex flex-col gap-6">
        <p class="eyebrow" data-kicker>Your order</p>
        <h1 id="confirmation-heading" tabindex="-1" data-heading>
          Thank you. <em>Next, payment</em>
        </h1>
        <p class="measure lead text-ink-muted" data-intro>
          Nothing has been charged. Pay by EFT or SnapScan using your reference,
          and we'll take it from there. A copy of everything here is in your
          inbox.
        </p>
      </header>

      <p class="measure conf-message" role="status" data-message hidden></p>

      <div class="conf-ref" data-ref-block hidden>
        <p class="eyebrow">Your reference</p>
        <p class="conf-ref__value order-ref tabular" data-ref></p>
        <div class="conf-ref__actions">
          <button type="button" class="btn" data-copy>Copy reference</button>
          <span
            class="field-hint"
            role="status"
            aria-live="polite"
            data-copy-status></span>
        </div>
        <p class="field-hint">
          Use it as the payment reference so we can match your payment.
        </p>
      </div>

      <section
        class="conf-summary"
        aria-labelledby="summary-heading"
        data-summary
        hidden
      >
        <div class="conf-summary__head">
          <h2 id="summary-heading" class="eyebrow">Order summary</h2>
          <p data-status-pill></p>
        </div>
        <dl class="summary-list tabular">
          <div class="summary-row">
            <dt data-line-label></dt>
            <dd data-line-amount></dd>
          </div>
          <div class="summary-row" data-shipping-row hidden>
            <dt>Delivery, flat fee</dt>
            <dd data-shipping></dd>
          </div>
          <div class="summary-row summary-total">
            <dt>Total to pay</dt>
            <dd data-total></dd>
          </div>
        </dl>
      </section>
    </div>
  </section>

  <section
    class="band band-alt"
    aria-labelledby="payment-heading"
    data-payment
    hidden
  >
    <div class="section-inner conf-stack">
      <h2 id="payment-heading">How to pay</h2>

      <div class="pay-grid">
        <section class="pay-panel" aria-labelledby="pay-eft" data-eft>
          <h3 id="pay-eft" class="eyebrow">Bank transfer, EFT</h3>
          <dl class="pay-details">
            <div data-detail="bankName">
              <dt>Bank</dt>
              <dd></dd>
            </div>
            <div data-detail="accountName">
              <dt>Account name</dt>
              <dd></dd>
            </div>
            <div data-detail="accountNumber">
              <dt>Account number</dt>
              <dd class="tabular"></dd>
            </div>
            <div data-detail="branchCode">
              <dt>Branch code</dt>
              <dd class="tabular"></dd>
            </div>
            <div data-detail="reference">
              <dt>Reference</dt>
              <dd class="order-ref tabular"></dd>
            </div>
          </dl>
        </section>

        <section
          class="pay-panel"
          aria-labelledby="pay-snapscan"
          data-snapscan
          hidden
        >
          <h3 id="pay-snapscan" class="eyebrow">SnapScan</h3>
          <p class="text-ink-muted">
            Pay from the SnapScan app on your phone. Enter the total and put
            your reference in the note.
          </p>
          <a
            class="btn"
            data-snapscan-link
            href="#"
            target="_blank"
            rel="noopener noreferrer"
          >
            Pay with SnapScan
          </a>
        </section>

        <section
          class="pay-panel"
          aria-labelledby="pay-payshap"
          data-payshap
          hidden
        >
          <h3 id="pay-payshap" class="eyebrow">PayShap</h3>
          <dl class="pay-details">
            <div>
              <dt>ShapID</dt>
              <dd class="tabular" data-payshap-id></dd>
            </div>
          </dl>
        </section>
      </div>

      <div class="flex flex-col items-start gap-4">
        <p class="measure">
          Once you've paid, send us the proof of payment so we can release your
          order sooner.
        </p>
        <a
          class="btn"
          data-proof
          href="#"
          target="_blank"
          rel="noopener noreferrer"
          hidden
        >
          Send proof on WhatsApp
        </a>
        <p class="field-hint">
          Or email it to <a href={`mailto:${CONTACT.email}`}>{CONTACT.email}</a
          >.
        </p>
      </div>
    </div>
  </section>

  <section class="band" aria-labelledby="next-heading" data-next hidden>
    <div class="section-inner conf-stack">
      <h2 id="next-heading">What happens next</h2>
      <ol class="next-list measure">
        <li>We check your payment against your reference.</li>
        <li data-next-digital>
          For the digital planner, we email you a download link. It works for a
          limited time and a limited number of downloads, so save the file once
          it's on your device.
        </li>
        <li data-next-physical hidden>
          For physical items, we email you when payment is in, then courier your
          order to the address you gave us.
        </li>
      </ol>
      <p class="measure text-ink-muted">
        Questions about your order? Quote your reference and see our <a
          href="/refunds">refund policy</a
        >.
      </p>
    </div>
  </section>

  <noscript>
    <section class="band">
      <div class="section-inner">
        <p class="measure">
          This page needs JavaScript to show your order. Everything is also in
          the invoice we emailed you.
        </p>
      </div>
    </section>
  </noscript>
</BaseLayout>

<script>
  import { formatZAR } from "../../lib/format-zar";
  import {
    fetchConfig,
    fetchSummary,
    isFilled,
    isReference,
    proofOfPaymentText,
    randsToCents,
    recallPlaced,
    whatsappUrl,
    type ApiBusiness,
    type OrderStatus,
  } from "../../lib/orders";

  interface Shown {
    reference: string;
    product_name: string;
    qty: number;
    unit_price: number;
    shipping: number;
    total: number;
    status?: OrderStatus;
    type?: "digital" | "physical";
  }

  const STATUS_LABEL: Record<OrderStatus, string> = {
    pending: "Awaiting payment",
    paid: "Payment received",
    delivered: "Paid and sent",
    cancelled: "Cancelled",
  };

  function q<T extends Element>(selector: string): T | null {
    return document.querySelector<T>(selector);
  }

  function show(selector: string, visible = true): void {
    const node = q<HTMLElement>(selector);
    if (node) node.hidden = !visible;
  }

  function text(selector: string, value: string): void {
    const node = q<HTMLElement>(selector);
    if (node) node.textContent = value;
  }

  function message(value: string): void {
    text("[data-message]", value);
    show("[data-message]");
  }

  function renderSummary(order: Shown): void {
    text("[data-line-label]", `${order.product_name} × ${String(order.qty)}`);
    text(
      "[data-line-amount]",
      formatZAR(randsToCents(order.unit_price * order.qty)),
    );
    if (order.shipping > 0) {
      text("[data-shipping]", formatZAR(randsToCents(order.shipping)));
      show("[data-shipping-row]");
    }
    text("[data-total]", formatZAR(randsToCents(order.total)));
    const pill = q<HTMLElement>("[data-status-pill]");
    if (pill && order.status) {
      pill.textContent = STATUS_LABEL[order.status];
      pill.className = [
        "badge",
        order.status === "cancelled"
          ? "badge-caution"
          : order.status === "pending"
            ? "badge-sold"
            : "badge-positive",
      ].join(" ");
    }
    show("[data-summary]");
  }

  function renderPayment(reference: string, business: ApiBusiness): void {
    let eftRows = 0;
    for (const key of [
      "bankName",
      "accountName",
      "accountNumber",
      "branchCode",
    ] as const) {
      const row = q<HTMLElement>(`[data-detail="${key}"]`);
      const dd = row?.querySelector("dd");
      if (!row || !dd) continue;
      if (isFilled(business[key])) {
        dd.textContent = business[key];
        row.hidden = false;
        eftRows += 1;
      } else {
        row.hidden = true;
      }
    }
    const refRow = q<HTMLElement>('[data-detail="reference"] dd');
    if (refRow) refRow.textContent = reference;
    show("[data-eft]", eftRows > 0);

    if (isFilled(business.snapscanUrl)) {
      const link = q<HTMLAnchorElement>("[data-snapscan-link]");
      if (link) link.href = business.snapscanUrl;
      show("[data-snapscan]");
    }
    if (isFilled(business.payshapId)) {
      text("[data-payshap-id]", business.payshapId);
      show("[data-payshap]");
    }
    if (isFilled(business.whatsapp)) {
      const proof = q<HTMLAnchorElement>("[data-proof]");
      if (proof) {
        proof.href = whatsappUrl(
          business.whatsapp,
          proofOfPaymentText(reference),
        );
        proof.hidden = false;
      }
    }
    show("[data-payment]");
  }

  let copyController: AbortController | undefined;

  async function init(): Promise<void> {
    if (!q("[data-ref-block]")) return;
    copyController?.abort();
    copyController = new AbortController();
    const { signal } = copyController;

    const reference = new URLSearchParams(location.search).get("ref") ?? "";
    if (!isReference(reference)) {
      text("[data-kicker]", "Order");
      text("[data-heading]", "We couldn't find that order");
      text(
        "[data-intro]",
        "This link doesn't include a valid order reference. Your reference starts with FLTM and is in the email we sent when you ordered.",
      );
      return;
    }

    text("[data-ref]", reference);
    show("[data-ref-block]");
    const copy = q<HTMLButtonElement>("[data-copy]");
    copy?.addEventListener(
      "click",
      () => {
        void navigator.clipboard
          .writeText(reference)
          .then(() => text("[data-copy-status]", "Copied."))
          .catch(() =>
            text("[data-copy-status]", "Select the reference to copy it."),
          );
      },
      { signal },
    );

    const [summary, config] = await Promise.all([
      fetchSummary(reference),
      fetchConfig(),
    ]);
    if (signal.aborted) return;

    let shown: Shown | null = null;
    if (summary.ok) {
      shown = summary.data;
    } else {
      shown = recallPlaced(reference);
      if (summary.status === 404 && !shown) {
        message(
          "We can't find this order yet. If you've just ordered, refresh in a minute. Your invoice email has the full details.",
        );
      } else if (!shown) {
        message(
          "We couldn't load your order details just now. Your invoice email has them, and the payment details are below.",
        );
      }
    }
    if (shown) renderSummary(shown);

    if (shown?.status === "cancelled") {
      text("[data-heading]", "This order was cancelled");
      text(
        "[data-intro]",
        "Please don't pay for it. If you think this is a mistake, contact us and quote the reference.",
      );
      return;
    }
    if (shown?.status === "paid" || shown?.status === "delivered") {
      text("[data-heading]", "Payment received");
      text(
        "[data-intro]",
        "Thank you. Your payment is in and your order is on its way to you.",
      );
    }

    if (config.ok) {
      renderPayment(reference, config.data.business);
    } else if (!shown) {
      message(
        "We couldn't load the payment details just now. They're in your invoice email, or refresh this page.",
      );
    }

    const physical = shown?.type === "physical";
    show("[data-next-digital]", !physical);
    show("[data-next-physical]", physical || shown?.type === undefined);
    show("[data-next]");
  }

  void init();
  document.addEventListener("astro:page-load", () => void init());
</script>

<style>
  .conf-stack {
    display: flex;
    flex-direction: column;
    gap: var(--space-12);
  }

  .conf-message {
    padding: var(--space-6);
    border: var(--size-hairline) solid var(--color-hairline);
    background-color: var(--color-surface-raised);
  }

  .conf-ref {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    padding-block: var(--space-8);
    border-block: var(--size-hairline) solid var(--color-hairline);
  }

  .conf-ref[hidden],
  .conf-summary[hidden],
  .conf-message[hidden] {
    display: none;
  }

  .conf-ref__value {
    color: var(--color-accent);
    font-size: var(--text-display-1);
    font-weight: 600;
    line-height: 1.1;
    overflow-wrap: anywhere;
  }

  .conf-ref__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-4);
  }

  .conf-summary {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    max-width: var(--measure-body);
  }

  .conf-summary__head {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
  }

  .pay-grid {
    display: grid;
    gap: var(--space-8);
  }

  @media (min-width: 48rem) {
    .pay-grid {
      grid-template-columns: repeat(
        auto-fit,
        minmax(calc(var(--space-32) * 2), 1fr)
      );
    }
  }

  .pay-panel {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-6);
    padding: var(--space-8);
    background-color: var(--color-surface);
    border: var(--size-hairline) solid var(--color-hairline);
  }

  .pay-panel[hidden] {
    display: none;
  }

  .pay-details {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    margin: 0;
    width: 100%;
  }

  .pay-details > div {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
  }

  .pay-details > div[hidden] {
    display: none;
  }

  .pay-details dt {
    color: var(--color-ink-subtle);
    font-size: var(--text-xs);
  }

  .pay-details dd {
    margin: 0;
    font-size: var(--text-lg);
  }

  .next-list {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    margin: 0;
    padding-left: var(--space-6);
    list-style: decimal;
  }

  .next-list li[hidden] {
    display: none;
  }
</style>
