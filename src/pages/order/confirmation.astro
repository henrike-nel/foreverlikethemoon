---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { CONTACT } from "../../lib/site";

// No-JS fallback proof link: a plain WhatsApp message with no reference. The
// island upgrades this to a reference-tagged message once it reads ?ref=.
const waNumber = CONTACT.phoneHref.replace(/\D/g, "");
const genericProofUrl = `https://wa.me/${waNumber}?text=${encodeURIComponent(
  "Hi Foreverlikethemoon — proof of payment for my order attached.",
)}`;
---

<BaseLayout
  title="Order received — Foreverlikethemoon"
  description="Your order reference and payment instructions."
  noindex
>
  <section class="band" aria-labelledby="confirmation-heading">
    <div class="section-inner conf-layout">
      <header class="flex flex-col gap-4">
        <p class="eyebrow">Order received</p>
        <h1 id="confirmation-heading">Thank you — next, payment</h1>
        <p class="measure text-ink-muted">
          Nothing has been charged. Pay by EFT or PayShap using the details
          below, quoting your reference, then send us proof of payment.
        </p>
      </header>

      <div class="conf-ref">
        <p class="eyebrow">Your reference</p>
        <p class="conf-ref-value order-ref tabular" data-ref>
          See your order message
        </p>
        <div class="conf-ref-actions" data-copy-wrap hidden>
          <button type="button" class="btn" data-copy>Copy reference</button>
          <span class="field-hint" role="status" aria-live="polite" data-copy-status
          ></span>
        </div>
        <p class="field-hint" data-ref-fallback>
          Your reference was shown on the order form and is in our reply. Quote
          it on your payment and any message to us.
        </p>
      </div>
    </div>
  </section>

  <section class="band band-alt" aria-labelledby="payment-heading">
    <div class="section-inner conf-layout">
      <h2 id="payment-heading">How to pay</h2>

      <div class="conf-grid">
        <div class="conf-panel" role="group" aria-label="Bank transfer (EFT)">
          <p class="eyebrow">Bank transfer — EFT</p>
          <div class="placeholder-block" data-placeholder>
            <p class="placeholder-tag">Placeholder — Henrike to supply</p>
            <p>Account name, bank, account number, branch code.</p>
          </div>
        </div>

        <div class="conf-panel" role="group" aria-label="PayShap">
          <p class="eyebrow">PayShap</p>
          <div class="placeholder-block" data-placeholder>
            <p class="placeholder-tag">Placeholder — Henrike to supply</p>
            <p>ShapID or proxy, and any reference format required.</p>
          </div>
        </div>
      </div>

      <p class="measure">
        Use your reference as the payment reference so we can match it.
      </p>

      <div class="order-actions">
        <a
          class="btn"
          data-proof
          href={genericProofUrl}
          target="_blank"
          rel="noopener"
        >
          Send proof of payment on WhatsApp
        </a>
        <p class="field-hint">
          Or email it to <a href={`mailto:${CONTACT.email}`}>{CONTACT.email}</a>.
        </p>
      </div>
    </div>
  </section>

  <section class="band" aria-labelledby="next-heading">
    <div class="section-inner conf-layout">
      <h2 id="next-heading">What happens next</h2>
      <ul class="conf-list measure">
        <li>
          <strong>Digital planner.</strong> Emailed as a PDF to the address on your
          order within 24 hours of payment clearing.
        </li>
        <li>
          <strong>Physical items.</strong> Printed and packed in Cape Town, then
          couriered nationwide. Dispatch window:
          <mark class="placeholder-inline">[ PLACEHOLDER — dispatch window in working days ]</mark>
          once payment clears.
        </li>
      </ul>

      <p class="measure text-ink-muted conf-ecta">
        Note: the seven-day cooling-off right under the Electronic Communications
        and Transactions Act does <strong>not</strong> apply once a digital file
        has been downloaded. See our <a href="/refunds">refunds page</a> for the
        full terms.
      </p>
    </div>
  </section>
</BaseLayout>

<script>
  import { isReferenceShaped, proofOfPaymentUrl } from "../../lib/orders";

  function init(): void {
    const params = new URLSearchParams(location.search);
    const ref = params.get("ref");

    const refEl = document.querySelector<HTMLElement>("[data-ref]");
    const copyWrap = document.querySelector<HTMLElement>("[data-copy-wrap]");
    const copyBtn = document.querySelector<HTMLButtonElement>("[data-copy]");
    const copyStatus = document.querySelector<HTMLElement>("[data-copy-status]");
    const fallback = document.querySelector<HTMLElement>("[data-ref-fallback]");
    const proof = document.querySelector<HTMLAnchorElement>("[data-proof]");

    if (!ref || !isReferenceShaped(ref)) {
      return; // Keep the no-reference fallback copy and generic proof link.
    }

    if (refEl) {
      refEl.textContent = ref;
    }
    if (fallback) {
      fallback.hidden = true;
    }
    if (proof) {
      proof.href = proofOfPaymentUrl(ref);
    }
    if (copyWrap) {
      copyWrap.hidden = false;
    }

    copyBtn?.addEventListener("click", () => {
      void navigator.clipboard
        .writeText(ref)
        .then(() => {
          if (copyStatus) {
            copyStatus.textContent = "Copied.";
          }
        })
        .catch(() => {
          if (copyStatus) {
            copyStatus.textContent = "Press ⌘/Ctrl+C to copy.";
          }
        });
    });
  }

  init();
  document.addEventListener("astro:page-load", init);
</script>

<style>
  .conf-layout {
    display: flex;
    flex-direction: column;
    gap: var(--space-8);
  }

  .conf-ref {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    padding: var(--space-8);
    background-color: var(--color-surface-raised);
    border: var(--size-hairline) solid var(--color-hairline);
  }

  .conf-ref-value {
    font-size: var(--text-display-1);
    font-weight: 600;
    color: var(--color-accent);
    overflow-wrap: anywhere;
  }

  .conf-ref-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-4);
    margin-top: var(--space-2);
  }

  .conf-grid {
    display: grid;
    gap: var(--space-8);
    grid-template-columns: 1fr;
  }

  @media (min-width: 40rem) {
    .conf-grid {
      grid-template-columns: 1fr 1fr;
    }
  }

  .conf-panel {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .placeholder-block {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    padding: var(--space-6);
    background-color: var(--color-surface-card);
    border: var(--size-hairline) dashed var(--color-hairline);
    color: var(--color-ink-muted);
  }

  .placeholder-tag {
    font-family: var(--font-body);
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: var(--tracking-eyebrow);
    text-transform: uppercase;
    color: var(--color-ink-subtle);
  }

  .placeholder-inline {
    background-color: var(--color-surface-raised);
    color: var(--color-ink-subtle);
    padding-inline: var(--space-1);
  }

  .conf-list {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .conf-ecta {
    padding-top: var(--space-4);
    border-top: var(--size-hairline) solid var(--color-hairline);
  }
</style>
