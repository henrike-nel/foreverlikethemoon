---
import { Image } from "astro:assets";
import { getCollection, getEntry } from "astro:content";
import heroImage from "../assets/hero-tablescape-linen.jpg";
import verseImage from "../assets/texture-vellum-candlelight.jpg";
import founderImage from "../assets/founder-portrait.jpg";
import Band from "../components/Band.astro";
import ProductCard from "../components/ProductCard.astro";
import SectionEyebrow from "../components/SectionEyebrow.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import { organizationLocalBusiness } from "../lib/json-ld";
import { CONTACT, SITE_TAGLINE } from "../lib/site";

const home = await getEntry("pages", "home");
if (!home) {
  throw new Error("Missing src/content/pages/home.md — home copy is required.");
}
const { hero, verse, founder } = home.data;

const [heroBefore, afterBrand = ""] = hero.heading.split(hero.brand);

const founderName = "Henrike";
const founderLead = founder.heading.endsWith(founderName)
  ? founder.heading.slice(0, -founderName.length)
  : founder.heading;
const founderNamed = founder.heading.endsWith(founderName);

const products = (await getCollection("products")).toSorted(
  (a, b) => a.data.order - b.data.order,
);

const testimonials = (await getCollection("testimonials"))
  .filter((t) => t.data.featured)
  .toSorted((a, b) => a.data.name.localeCompare(b.data.name));

const services = await getCollection("services");
const summaryFor = (id: string) =>
  services.find((s) => s.id === id)?.data.summary;

const serviceTeasers = [
  {
    title: "Printed Wedding Stationery",
    href: "/stationery",
    summary: summaryFor("stationery"),
  },
  {
    title: "Wedding Websites",
    href: "/websites",
    summary: summaryFor("websites"),
  },
  {
    title: "Digital Designs",
    href: "/digital-designs",
    summary: undefined,
  },
];

const whatsappNumber = CONTACT.phoneHref.replace(/[^0-9]/g, "");
const whatsappMessage =
  "Hi Henrike! I'd love to chat about stationery for our wedding.";
const whatsappHref = `https://wa.me/${whatsappNumber}?text=${encodeURIComponent(whatsappMessage)}`;

const jsonLd = Astro.site
  ? organizationLocalBusiness(Astro.site)
  : undefined;
---

<BaseLayout description={SITE_TAGLINE} jsonLd={jsonLd}>
  <div class="home">
    <section class="hero" aria-labelledby="hero-heading">
      <div class="hero__media">
        <Image
          src={heroImage}
          alt="A white linen table laid with gold-rimmed glassware, gold cutlery and a printed menu card."
          widths={[640, 1024, 1600, 2400]}
          sizes="100vw"
          loading="eager"
          fetchpriority="high"
        />
        <div class="hero__scrim" aria-hidden="true"></div>
      </div>
      <div class="hero__copy section-inner">
        <h1 id="hero-heading" class="font-display measure-display">
          {heroBefore}<em class="hero__brand">{hero.brand}</em>{afterBrand}
        </h1>
        <p>
          <a class="btn btn-ghost" href={hero.ctaHref}>{hero.cta}</a>
        </p>
      </div>
    </section>

    <Band labelledby="verse-heading" alt>
      <div class="verse">
        <figure class="verse__figure">
          <Image
            src={verseImage}
            alt="A sheer vellum menu glowing behind gauze in candlelight."
            widths={[400, 640, 800]}
            sizes="(min-width: 48rem) 45vw, 90vw"
            loading="lazy"
          />
        </figure>
        <div class="verse__body">
          <SectionEyebrow phase={0} id="verse" label="The verse" />
          <blockquote
            id="verse-heading"
            class="font-display text-display-2 italic measure-display"
          >
            {verse.brandPhrase}
          </blockquote>
          <cite class="eyebrow not-italic">{verse.citation}</cite>
          <div class="ornament-bar" aria-hidden="true"></div>
          <p class="lead measure text-ink-muted">{verse.positioning}</p>
        </div>
      </div>
    </Band>

    <Band labelledby="products-heading">
      <div class="flex flex-col gap-4">
        <SectionEyebrow phase={0.2} id="products" label="The collection" />
        <h2 id="products-heading">Planners and the emergency kit</h2>
      </div>
      <div class="product-grid mt-16">
        {products.map((product) => <ProductCard product={product} />)}
      </div>
    </Band>

    <Band labelledby="services-heading" alt>
      <div class="flex flex-col gap-4">
        <SectionEyebrow phase={0.4} id="services" label="Services" />
        <h2 id="services-heading">What I make</h2>
      </div>
      <div class="service-grid mt-16">
        {
          serviceTeasers.map((service) => (
            <a class="service-card" href={service.href}>
              <h3 class="service-card__title">{service.title}</h3>
              {service.summary && (
                <p class="text-ink-muted">{service.summary}</p>
              )}
              <span class="service-card__cue" aria-hidden="true">
                Explore
              </span>
            </a>
          ))
        }
      </div>
    </Band>

    <Band labelledby="founder-heading">
      <div class="founder">
        <figure class="founder__figure">
          <Image
            class="portrait-bw"
            src={founderImage}
            alt="Henrike Basson."
            widths={[320, 480, 640]}
            sizes="(min-width: 48rem) 40vw, 90vw"
            loading="lazy"
          />
        </figure>
        <div class="flex flex-col gap-8">
          <SectionEyebrow phase={0.6} id="founder" label="The maker" />
          <h2 id="founder-heading">
            {founderLead}
            {
              founderNamed && (
                <em class="italic-emphasis">{founderName}</em>
              )
            }
          </h2>
          <div class="measure flex flex-col gap-4 text-ink-muted">
            {founder.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
          </div>
        </div>
      </div>
    </Band>

    <Band labelledby="testimonials-heading" alt>
      <div class="flex flex-col gap-4">
        <SectionEyebrow phase={0.8} id="testimonials" label="Reviews" />
        <h2 id="testimonials-heading">In their words</h2>
      </div>
      <div class="testimonial-flow mt-16">
        {
          testimonials.map((t) => (
            <figure
              class="testimonial"
              lang={t.data.lang === "af" ? "af" : undefined}
            >
              <blockquote>{t.data.quote}</blockquote>
              <figcaption class="eyebrow not-italic">{t.data.name}</figcaption>
            </figure>
          ))
        }
      </div>
    </Band>

    <Band labelledby="contact-heading">
      <div class="contact">
        <div class="flex flex-col gap-8">
          <SectionEyebrow phase={1} id="contact" label="Connect" />
          <h2 id="contact-heading">Say hello</h2>
          <p class="measure text-ink-muted">
            Message on WhatsApp for the fastest reply, or email if you would
            rather write it all down first.
          </p>
          <p>
            <a class="btn" href={whatsappHref} rel="noreferrer">
              Message on WhatsApp
            </a>
          </p>
        </div>
        <address class="contact__facts not-italic">
          <div class="field">
            <span class="eyebrow">Email</span>
            <a href={`mailto:${CONTACT.email}`}>{CONTACT.email}</a>
          </div>
          <div class="field">
            <span class="eyebrow">Studio</span>
            <span class="text-ink-muted">
              {CONTACT.locality}, Cape Town, {CONTACT.region}
            </span>
          </div>
          <div class="field">
            <span class="eyebrow">Hours</span>
            <span class="text-ink-muted">{CONTACT.hoursLabel}</span>
          </div>
        </address>
      </div>
    </Band>
  </div>
</BaseLayout>
