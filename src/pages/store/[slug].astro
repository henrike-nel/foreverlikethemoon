---
import { getImage, Image } from "astro:assets";
import { getCollection, render } from "astro:content";
import StockBadge from "../../components/StockBadge.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { formatZAR } from "../../lib/format-zar";
import { productOffer } from "../../lib/json-ld";

export async function getStaticPaths() {
  const products = await getCollection("products");
  return products.map((product) => ({
    params: { slug: product.data.slug },
    props: { product },
  }));
}

const { product } = Astro.props;
const { Content } = await render(product);
const title = product.data.seo?.title ?? `${product.data.title} — Foreverlikethemoon`;
const description = product.data.seo?.description ?? product.data.summary;
const images = await Promise.all(
  product.data.gallery.map((src) => getImage({ src, width: 1200 })),
);
const imageAbs = Astro.site
  ? images.map((img) => new URL(img.src, Astro.site).href)
  : [];
const canonical = Astro.site
  ? new URL(`/store/${product.data.slug}`, Astro.site).href
  : `/store/${product.data.slug}`;
const jsonLd = productOffer({
  name: product.data.title,
  description,
  url: canonical,
  images: imageAbs,
  priceCents: product.data.price,
  currency: product.data.currency,
  stock: product.data.stock,
});
---

<BaseLayout
  title={title}
  description={description}
  ogImage={images[0]?.src}
  ogType="product"
  jsonLd={jsonLd}
>
  <article class="page flex flex-col gap-8">
    <header class="flex flex-col gap-4">
      <h1 class="text-3xl">{product.data.title}</h1>
      <p class="measure text-ink-muted">{product.data.summary}</p>
      <p class="font-mono tabular text-accent">{formatZAR(product.data.price)}</p>
      <StockBadge stock={product.data.stock} />
      {
        product.data.stock === "in-stock" && (
          <p>Ordering opens with the new checkout.</p>
        )
      }
    </header>

    <div class="flex flex-col gap-4">
      {
        product.data.gallery.map((src, index) => (
          <Image
            class="border-hairline w-full border"
            src={src}
            alt={`${product.data.title}, photograph ${index + 1}`}
            widths={[480, 800, 1200]}
            sizes="min(100vw, 72rem)"
            loading={index === 0 ? "eager" : "lazy"}
            fetchpriority={index === 0 ? "high" : "auto"}
            transition:name={index === 0 ? `product-hero-${product.data.slug}` : undefined}
          />
        ))
      }
    </div>

    <div class="measure flex flex-col gap-4">
      <Content />
    </div>
  </article>
</BaseLayout>
