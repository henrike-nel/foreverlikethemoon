---
import { getImage, Image } from "astro:assets";
import { getCollection, render } from "astro:content";
import StockBadge from "../../components/StockBadge.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { formatZAR } from "../../lib/format-zar";
import { productOffer } from "../../lib/json-ld";
import { CONTACT } from "../../lib/site";

export async function getStaticPaths() {
  const products = await getCollection("products");
  return products.map((product) => ({
    params: { slug: product.data.slug },
    props: { product },
  }));
}

const { product } = Astro.props;
const { Content } = await render(product);
const title =
  product.data.seo?.title ?? `${product.data.title} — Foreverlikethemoon`;
const description = product.data.seo?.description ?? product.data.summary;
const images = await Promise.all(
  product.data.gallery.map((src) => getImage({ src, width: 1200 })),
);
const imageAbs = Astro.site
  ? images.map((img) => new URL(img.src, Astro.site).href)
  : [];
const canonical = Astro.site
  ? new URL(`/store/${product.data.slug}`, Astro.site).href
  : `/store/${product.data.slug}`;
const jsonLd = productOffer({
  name: product.data.title,
  description,
  url: canonical,
  images: imageAbs,
  priceCents: product.data.price,
  currency: product.data.currency,
  stock: product.data.stock,
});
---

<BaseLayout
  title={title}
  description={description}
  ogImage={images[0]?.src}
  ogType="product"
  jsonLd={jsonLd}
>
  <article class="band" aria-labelledby="product-heading">
    <div class="section-inner product">
      <div class="product__gallery">
        {
          product.data.gallery.map((src, index) => (
            <Image
              src={src}
              alt={`${product.data.title}, photograph ${index + 1} of ${product.data.gallery.length}`}
              widths={[480, 800, 1200]}
              sizes="(min-width: 56rem) 55vw, 92vw"
              loading={index === 0 ? "eager" : "lazy"}
              fetchpriority={index === 0 ? "high" : "auto"}
              transition:name={
                index === 0 ? `product-hero-${product.data.slug}` : undefined
              }
            />
          ))
        }
      </div>

      <div class="product__details">
        <nav aria-label="Breadcrumb">
          <a class="eyebrow product__crumb" href="/store">Store</a>
        </nav>
        <header class="flex flex-col gap-6">
          <h1 id="product-heading">{product.data.title}</h1>
          <p class="lead text-ink-muted">{product.data.summary}</p>
        </header>

        <div class="product__buy">
          <p class="product__price tabular text-accent">
            {formatZAR(product.data.price)}
          </p>
          <StockBadge stock={product.data.stock} />
          {
            product.data.stock === "in-stock" ? (
              <a
                class="btn self-start"
                href={`/order?product=${product.data.slug}`}
              >
                Order now
              </a>
            ) : (
              <p class="text-ink-muted">
                <a
                  href={`mailto:${CONTACT.email}?subject=${encodeURIComponent(`Tell me when the ${product.data.title.toLowerCase()} is back`)}`}
                >
                  Email us
                </a>{" "}
                and we'll tell you when it's back.
              </p>
            )
          }
          <p class="field-hint">
            {
              product.data.kind === "digital"
                ? "Digital product. Delivered by email as a PDF once payment clears; nothing is shipped."
                : "Couriered within South Africa for a flat fee, shown before you order."
            }
          </p>
        </div>

        <div class="prose">
          <Content />
        </div>

        {
          product.data.included && (
            <section class="flex flex-col gap-4" aria-labelledby="included">
              <h2 id="included" class="eyebrow">
                What's included
              </h2>
              <ul class="product__included">
                {product.data.included.map((line) => (
                  <li>{line}</li>
                ))}
              </ul>
            </section>
          )
        }
      </div>
    </div>
  </article>
</BaseLayout>

<style>
  .product {
    display: grid;
    gap: var(--space-12);
    align-items: start;
  }

  @media (min-width: 56rem) {
    .product {
      grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
      gap: var(--space-16);
    }

    .product__details {
      position: sticky;
      top: var(--space-24);
    }
  }

  .product__gallery {
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
  }

  .product__gallery img {
    display: block;
    width: 100%;
    height: auto;
  }

  .product__details {
    display: flex;
    flex-direction: column;
    gap: var(--space-8);
  }

  .product__crumb {
    text-decoration: none;
  }

  .product__crumb:hover {
    color: var(--color-accent);
  }

  .product__buy {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    padding-block: var(--space-8);
    border-block: var(--size-hairline) solid var(--color-hairline);
  }

  .product__price {
    font-size: var(--text-xl);
  }

  .product__included {
    display: flex;
    flex-direction: column;
    color: var(--color-ink-muted);
  }

  .product__included li {
    padding-block: var(--space-2);
    border-bottom: var(--size-hairline) solid var(--color-hairline-soft);
  }
</style>
